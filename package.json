{
  "name": "kitsune-marketplace",
  "version": "1.0.0",
  "description": "Kitsune - 0G Verifiable Agent Marketplace Monorepo",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "relayer": "npm --prefix relayer run dev",
    "build:relayer": "npm --prefix relayer run build",
    "compile:contracts": "npm --prefix contracts run compile",
    "test:contracts": "npm --prefix contracts test"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "clsx": "^2.1.0",
    "ethers": "^6.11.1",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.60",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.17",
    "hardhat": "^2.26.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  },
  "workspaces": [
    "contracts",
    "relayer",
    "frontend"
  ]
}
