# =========================================================
# Kitsune 0G Marketplace Environment Configuration Template
# IMPORTANT: Never commit actual private keys to public git!
# =========================================================

# 0G Chain Network RPC URLs
OG_ARISTOTLE_RPC=https://evmrpc.0g.ai
OG_GALILEO_RPC=http://evmrpc-testnet.0g.ai
LOCAL_RPC=http://127.0.0.1:8545

# Deployer / Admin Wallet Private Key (Without 0x prefix)
PRIVATE_KEY=your_deployer_private_key_here

# Off-Chain Relayer & Compute Worker Private Keys
RELAYER_PRIVATE_KEY=your_relayer_private_key_here
WORKER_PRIVATE_KEY=your_worker_private_key_here

# Deployed Contract Addresses (Populated automatically after deploy)
NEXT_PUBLIC_ARISTOTLE_AGENTIC_ID=0x78570G00000000000000000000000000000000A1
NEXT_PUBLIC_ARISTOTLE_MARKETPLACE=0x0G000000000000000000000000000000000000M1

NEXT_PUBLIC_GALILEO_AGENTIC_ID=0x78570G00000000000000000000000000000000T1
NEXT_PUBLIC_GALILEO_MARKETPLACE=0x0G000000000000000000000000000000000000T2

# 0G Storage Indexer & RPC Endpoints
OG_STORAGE_INDEXER_RPC=https://indexer-storage-testnet.0g.ai
OG_STORAGE_NODE_RPC=https://rpc-storage-testnet.0g.ai